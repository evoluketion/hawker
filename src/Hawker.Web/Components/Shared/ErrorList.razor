@if (Errors is { Count: > 0 })
{
    <div class="alert alert-bad" role="alert">
        @if (Errors.Count == 1)
        {
            @Errors[0]
        }
        else
        {
            <strong>Please fix the following:</strong>
            <ul>
                @foreach (var error in Errors)
                {
                    <li>@error</li>
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<string>? Errors { get; set; }
}
