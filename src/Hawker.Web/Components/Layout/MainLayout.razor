@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar">
        <div class="brand">Hawker</div>
        <div class="brand-sub">Your newspaper, printed on schedule</div>
        <nav class="nav">
            <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="editions">Editions</NavLink>
            <NavLink href="feeds">Feeds</NavLink>
            <NavLink href="archive">Archive</NavLink>
            <NavLink href="settings">Settings</NavLink>
        </nav>
    </aside>
    <main class="main">
        <UpdateNotice />
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong on this page.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
