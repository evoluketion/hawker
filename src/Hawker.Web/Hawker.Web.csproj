<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Hawker.Core\Hawker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inlined into every newspaper so rendering needs no files or network. -->
    <Content Remove="Rendering\newspaper.css" />
    <EmbeddedResource Include="Rendering\newspaper.css" />
    <EmbeddedResource Include="Rendering\Fonts\*.ttf" />
    <None Include="Rendering\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray/hawker.png is the one source image for the tray on every platform; hawker.ico exists only because the
         exe's own icon has to be a .ico. Replace both together. -->
    <EmbeddedResource Include="Tray\hawker.png" LogicalName="Hawker.Tray.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development settings point the data folder into the repo; never ship them. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <ApplicationIcon>hawker.ico</ApplicationIcon>
    <!-- The published Windows exe opens no window by itself; ConsoleWindow gives it one outside headless mode.
         Builds without a runtime identifier (dotnet run, tests) stay console apps. -->
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    <!-- LibraryImport and the fixed-size buffers in the Win32 tray structs need it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The package that adds _framework/blazor.web.js only does so for Exe projects, so a WinExe build ships without
       it and no button works. Present as Exe for just that target. Its condition is checked before any BeforeTargets
       run, so the switch has to come earlier in the same dependency list. -->
  <PropertyGroup>
    <ResolveStaticWebAssetsInputsDependsOn>_PresentAsExeForBlazorFramework;$(ResolveStaticWebAssetsInputsDependsOn)</ResolveStaticWebAssetsInputsDependsOn>
  </PropertyGroup>
  <Target Name="_PresentAsExeForBlazorFramework" Condition="'$(OutputType)' == 'WinExe'">
    <PropertyGroup>
      <_HawkerRestoreWinExe>true</_HawkerRestoreWinExe>
      <OutputType>Exe</OutputType>
    </PropertyGroup>
  </Target>
  <Target Name="_RestoreWinExeAfterBlazorFramework" AfterTargets="_AddBlazorFrameworkStaticWebAssets" Condition="'$(_HawkerRestoreWinExe)' == 'true'">
    <PropertyGroup>
      <OutputType>WinExe</OutputType>
    </PropertyGroup>
  </Target>

</Project>
